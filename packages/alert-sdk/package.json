{
  "name": "@incident-platform/sdk",
  "version": "0.2.0",
  "description": "Send alerts to the incident platform from any Node.js (18+) application: alerts, resolves, exceptions and job monitoring, with retries.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@incident-platform/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "incident",
    "alerting",
    "on-call",
    "monitoring"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "example": "tsx --conditions=@incident-platform/source examples/checkout-service.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
