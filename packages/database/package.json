  "dependencies": {
    "@irp/shared": "*",
    "bcryptjs": "^3.0.2",
    "dotenv": "^18.0.7",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
