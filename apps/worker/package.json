{
  "name": "@irp/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Background worker: escalation policies, notification delivery and recovery sweeps (BullMQ).",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include=src --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.exclude=src/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@irp/database": "*",
    "@irp/shared": "*",
    "bullmq": "^5.58.0",
    "ioredis": "^5.7.0",
    "nodemailer": "^10.1.7",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
