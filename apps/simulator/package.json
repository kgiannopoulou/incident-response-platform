{
  "name": "@irp/simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plays production incidents against a running platform, so no real infrastructure is needed to try it.",
  "scripts": {
    "simulate": "tsx src/scenarios.ts",
    "demo:incident": "tsx src/demo-incident.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@irp/alert-sdk": "*",
    "@irp/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
