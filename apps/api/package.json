{
  "name": "@irp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "REST API: alert ingestion, incident lifecycle, postmortems, audit log and a Server-Sent Events stream.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p .",
    "openapi": "tsx scripts/write-openapi.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include=src --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.exclude=src/index.ts"
  },
  "dependencies": {
    "@irp/database": "*",
    "@irp/shared": "*",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.58.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@incident-platform/sdk": "*",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
