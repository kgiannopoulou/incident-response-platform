# Shared by apps/api, apps/worker and packages/database scripts.
DATABASE_URL=postgres://incidents:incidents@localhost:5435/incidents
REDIS_URL=redis://localhost:6380
JWT_SECRET=change-me-to-a-long-random-string
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Email pages. Locally: Mailpit from docker compose (inbox http://localhost:8025).
# When SMTP_URL is unset the worker only logs each email.
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Fireline <pager@fireline.local>
# Refuse outgoing webhooks to private/loopback addresses (SSRF protection,
# checked on the resolved address). Defaults to true when NODE_ENV=production;
# false here so you can test against a receiver on localhost.
WEBHOOK_BLOCK_PRIVATE_NETWORKS=false
# true when the API is served over HTTPS (Secure cookie + HSTS).
COOKIE_SECURE=false
# Failed API-key authentications allowed per client IP per minute before 429.
AUTH_FAILURES_PER_MINUTE=20
# AI postmortem drafts (worker). With an Anthropic API key the worker drafts with
# Claude; without one it uses deterministic offline rules (labelled as such in the UI).
# AI_POSTMORTEM_PROVIDER: auto (default) | claude | rules
ANTHROPIC_API_KEY=
AI_POSTMORTEM_PROVIDER=auto
AI_POSTMORTEM_MODEL=claude-opus-5-5
# AI incident investigator (worker). Same rule: with an Anthropic API key Claude runs it as an agent
# over read-only evidence tools; without one, deterministic correlation rules (labelled as such).
# INVESTIGATOR_PROVIDER: auto (default) | claude | rules
INVESTIGATOR_PROVIDER=auto
INVESTIGATOR_MODEL=claude-opus-5-5
# Set when the API runs behind a reverse proxy (e.g. 1), so rate limiting sees client IPs.
TRUST_PROXY=
# Demo mode: the dashboard's "Simulate production incident" button (admins), and the
# example JWT_SECRET is accepted with a warning. A real installation sets DEMO_ENABLED=false,
# and the API then refuses to start with a JWT_SECRET shorter than 32 characters or an example value.
DEMO_ENABLED=true
