# Shared by apps/api, apps/worker and packages/database scripts.
DATABASE_URL=postgres://incidents:incidents@localhost:5435/incidents
REDIS_URL=redis://localhost:6380
JWT_SECRET=change-me-to-a-long-random-string
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Optional: Slack-compatible incoming webhook. When unset, notifications are
# recorded and logged by the worker but not sent anywhere.
NOTIFY_WEBHOOK_URL=
COOKIE_SECURE=false
