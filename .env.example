# Shared by apps/api, apps/worker and packages/database scripts.
DATABASE_URL=postgres://incidents:incidents@localhost:5435/incidents
REDIS_URL=redis://localhost:6380
JWT_SECRET=change-me-to-a-long-random-string
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Email pages. Locally: Mailpit from docker compose (inbox http://localhost:8025).
# When SMTP_URL is unset the worker only logs each email.
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Fireline <pager@fireline.local>
# Refuse outgoing webhooks to private/loopback addresses (SSRF protection).
# Keep false locally so you can test against a receiver on localhost.
WEBHOOK_BLOCK_PRIVATE_NETWORKS=false
COOKIE_SECURE=false
# Failed API-key authentications allowed per client IP per minute before 429.
AUTH_FAILURES_PER_MINUTE=20
# AI postmortem drafts (worker). With an Anthropic API key the worker drafts with
# Claude; without one it uses deterministic offline rules (labelled as such in the UI).
# AI_POSTMORTEM_PROVIDER: auto (default) | claude | rules
ANTHROPIC_API_KEY=
AI_POSTMORTEM_PROVIDER=auto
AI_POSTMORTEM_MODEL=claude-opus-5-5
# Set when the API runs behind a reverse proxy (e.g. 1), so rate limiting sees client IPs.
TRUST_PROXY=
