{
  "name": "incident-response-platform",
  "private": true,
  "description": "Incident management platform: alert ingestion, incident lifecycle, escalations, live updates and postmortems.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @irp/api",
    "dev:worker": "npm run dev -w @irp/worker",
    "dev:web": "npm run dev -w @irp/web",
    "db:migrate": "npm run migrate -w @irp/database",
    "db:seed": "npm run seed -w @irp/database",
    "infra:up": "docker compose up -d postgres redis mailpit",
    "stack:up": "docker compose up -d --build --wait",
    "stack:down": "docker compose down",
    "smoke": "node scripts/smoke-test.mjs",
    "loadtest": "node scripts/load-test.mjs",
    "openapi": "npm run openapi -w @irp/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint && npm run lint -w @irp/web",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test -w @irp/shared -w @incident-platform/sdk -w @irp/simulator",
    "test:integration": "npm run test -w @irp/api -w @irp/worker",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:unit:coverage": "npm run test:coverage -w @irp/shared -w @incident-platform/sdk -w @irp/simulator",
    "test:integration:coverage": "npm run test:coverage -w @irp/api -w @irp/worker",
    "simulate": "npm run simulate -w @irp/simulator",
    "demo:incident": "npm run demo:incident -w @irp/simulator --"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "globals": "^14.0.0",
    "typescript-eslint": "^8.71.2"
  }
}
